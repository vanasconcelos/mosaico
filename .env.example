# Supabase — preencher quando o projeto Supabase for criado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada apenas em server-side (API routes / server actions) para operações
# que precisam ignorar RLS (ex.: leitura de original_canva_url). NUNCA expor
# ao cliente, NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — preencher quando o checkout/webhook forem configurados.
# MERCADOPAGO_ACCESS_TOKEN: credencial do servidor usada pelo SDK (Preference
# e Payment). Nunca expor ao cliente.
MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET: segredo usado para validar a assinatura
# `x-signature` das notificações do webhook. Nunca expor ao cliente.
MERCADOPAGO_WEBHOOK_SECRET=
# NEXT_PUBLIC_SITE_URL: base usada para montar as back_urls do Checkout Pro
# (ex.: http://localhost:3000 em dev; precisa ser https em produção).
NEXT_PUBLIC_SITE_URL=
# MERCADOPAGO_ENV: declaração EXPLÍCITA do ambiente — só "test" ou
# "production", sem valor padrão. Na Vercel, precisa corresponder a
# VERCEL_ENV: "production" exige "production"; "preview" e "development"
# exigem "test". Fora da Vercel (ex.: next dev/next start local), precisa
# corresponder ao NODE_ENV (fora de produção: "test"; em produção:
# "production"). Qualquer descompasso faz checkout e webhook falharem de
# propósito (501). Isso é só uma declaração de configuração, não uma
# verificação do token em si — ver src/lib/server/mercadopago.ts.
MERCADOPAGO_ENV=
